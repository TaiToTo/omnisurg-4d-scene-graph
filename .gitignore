# Python
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Generated artifacts (regenerated by the pipeline; never tracked)
outputs/

# Inputs. Anchor with a leading / — without it this also swallows
# surgical_core/data/ and any other package directory called data/.
/data/

# Node / viewer
node_modules/
viewer/dist/

# NFS silly-rename leftovers (appear when an open file is deleted on NFS)
.nfs[0-9a-f]*

# Working material dropped at the repo root: notes, drafts, figures.
# Anchored, so documents and figures under docs/ are still tracked. A new
# document at the root needs its own ! line.
/*.md
!/AGENTS.md
!/CLAUDE.md
!/README.md
/*.tex
/*.pdf
/*.png
/*.jpg
/*.svg

# Claude Code: only the shared settings and hooks are tracked
.claude/*
!.claude/settings.json
!.claude/hooks/

# IDE / OS / secrets
.vscode/
.env
.DS_Store
*.orig

# Machine-specific notes (paths, usernames) — not portable, never committed
docs/local/
