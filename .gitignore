# Python
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Generated artifacts (regenerated by the pipeline; never tracked)
outputs/

# Where the v2 reference writes and reads by default. Those defaults describe
# the workbench it was measured in, relative to its own tree, and they cannot
# change without moving its sha, so what they produce is kept out of git.
/reference/eval_v2/ipcai2027_experiment/
/reference/eval_v2/evalkit/out*/

# Inputs. Anchor with a leading / — without it this also swallows
# surgical_core/data/ and any other package directory called data/.
/data/

# Node / viewer
node_modules/
viewer/dist/

# NFS silly-rename leftovers (appear when an open file is deleted on NFS)
.nfs[0-9a-f]*

# Working material dropped at the repo root. Anchored, so figures kept
# under docs/ are still tracked.
/*.pdf
/*.png
/*.jpg
/*.svg

# IDE / OS / secrets
.claude/
.vscode/
.env
**/.DS_Store
*.orig

# Machine-specific notes (paths, usernames) — not portable, never committed
docs/local/
