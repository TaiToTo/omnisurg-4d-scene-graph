{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/refuse_personal_email.py",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the command for a personal address"
          }
        ]
      }
    ]
  }
}
